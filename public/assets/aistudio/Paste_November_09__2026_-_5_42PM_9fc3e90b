<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Hero Character Animation Trigger
    const chars = document.querySelectorAll('.char-box');
    
    // Start staggered entrance dancing
    chars.forEach((char, index) => {
      setTimeout(() => {
        char.classList.add('dancing');
      }, index * 100);
    });

    // Once they have all appeared, settle them
    setTimeout(() => {
      chars.forEach(char => {
        char.classList.remove('dancing');
        char.classList.add('settled');
      });
    }, 2800);

    // Mobile Menu Toggle Logic
    const openBtn = document.getElementById('mobile-menu-open');
    const closeBtn = document.getElementById('mobile-menu-close');
    const menuOverlay = document.getElementById('mobile-menu');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    const toggleMenu = (isOpen) => {
      if (isOpen) {
        menuOverlay.classList.remove('translate-x-full');
        document.body.style.overflow = 'hidden'; 
      } else {
        menuOverlay.classList.add('translate-x-full');
        document.body.style.overflow = ''; 
      }
    };

    openBtn?.addEventListener('click', () => toggleMenu(true));
    closeBtn?.addEventListener('click', () => toggleMenu(false));
    
    navLinks.forEach(link => {
      link.addEventListener('click', () => toggleMenu(false));
    });

    // Hover Menu Image Mouse Tracking (Simplified for library)
    const menuItems = document.querySelectorAll('.menu-item-trigger');
    menuItems.forEach(item => {
      const img = item.querySelector('.menu-item-hover-image');
      if (img) {
        item.addEventListener('mousemove', (e) => {
          const rect = item.getBoundingClientRect();
          const x = e.clientX - rect.left;
          // Dynamically adjust image position slightly based on mouse
          img.style.transform = `translateY(-50%) translateX(${(x - rect.width / 2) / 10}px) rotate(${(x - rect.width / 2) / 50}deg)`;
        });
        item.addEventListener('mouseleave', () => {
          img.style.transform = `translateY(-50%) scale(0.9)`;
        });
      }
    });
  });
</script></main>
    
